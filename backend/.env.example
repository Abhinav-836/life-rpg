# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string (Neon, Supabase, Railway, Render or local)
DATABASE_URL="postgresql://user:password@localhost:5432/life_rpg?schema=public"

# Auth: use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s), comma-separated
CLIENT_ORIGIN=http://localhost:5173