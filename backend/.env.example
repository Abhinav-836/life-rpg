# Server
PORT=5000
NODE_ENV=development

# Database (Postgres connection string - Railway/Render/Supabase all give you this)
DATABASE_URL="postgresql://user:password@localhost:5432/life_rpg?schema=public"

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - your deployed frontend URL
CLIENT_ORIGIN=http://localhost:5173
